{
  "profiles": {
    "http": {
      "commandName": "Project", // on est sur un projet (on veut compiler et lancer)
      "launchBrowser": false, // mettre sur false -- est-ce qu'on veut lancer le navigateur et l'attaché
      "launchUrl": "", // url lorsque l'on lance l'application
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }, // comment on définit l'environnement quand on le lance (developpement, production..)
      "dotnetRunMessages": true, // est-ce qu'on veut que dotnet affiche els message de build
      "applicationUrl": "http://localhost:5287" // où est-ce que notre serveur va démarré, sur quel port
    },    
    
    "Container (Dockerfile)": {
      "commandName": "Docker",
      "launchBrowser": false,
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}/api",
      "environmentVariables": {
        "ASPNETCORE_HTTPS_PORTS": "8081",
        "ASPNETCORE_HTTP_PORTS": "8080"
      },
      "publishAllPorts": true,
      "useSSL": false
    }
  },
  "$schema": "http://json.schemastore.org/launchsettings.json"
}